APP_NAME=广告投放执行Agent
DATABASE_URL=mysql+asyncmy://root:password@127.0.0.1:3306/ad_serving_agent
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=ad_knowledge
# 与后续选定的 Embedding 模型维度一致
MILVUS_VECTOR_DIM=1024

JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

DASHSCOPE_API_KEY=replace-with-your-api-key
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1